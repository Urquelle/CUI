{
  "cui_designer": 1,
  "name": "settings",
  "preview": { "width": 720, "height": 640, "theme": "dark", "accent": "violet" },
  "root": {
    "id": "n1", "type": "column", "props": { "pad": 24, "gap": 16, "width": "fill", "height": "fill" },
    "children": [
      { "id": "n2", "type": "row", "props": { "gap": 8, "width": "fill" }, "children": [
        { "id": "n3", "type": "heading", "props": { "text": "Einstellungen", "level": "1" } },
        { "id": "n4", "type": "badge", "props": { "text": "Beta", "tone": "accent", "solid": true } },
        { "id": "n5", "type": "spacer", "props": {} },
        { "id": "n6", "type": "icon_button", "props": { "icon": "search", "tooltip": "Suchen" } },
        { "id": "n7", "type": "button", "props": { "label": "Speichern", "variant": "primary", "icon": "check", "size": "sm", "on_click": "settings_save" } }
      ] },
      { "id": "n8", "type": "tabs", "props": { "items": "Allgemein\nKonto\nBenachrichtigungen", "value": 1, "variant": "pill", "bind": "page" } },
      { "id": "n9", "type": "alert", "props": { "title": "Neue Version", "description": "Version 2.0 ist verfügbar.", "tone": "success", "icon": "info" } },
      { "id": "n10", "type": "grid", "props": { "columns": 2, "gap": 16, "width": "fill" }, "children": [
        { "id": "n11", "type": "card", "props": { "pad": 16, "gap": 10 }, "children": [
          { "id": "n12", "type": "text", "props": { "text": "Darstellung", "style": "label" } },
          { "id": "n13", "type": "switch", "props": { "label": "Dunkles Design", "value": true, "description": "Folgt sonst dem System", "on_change": "settings_theme_changed" } },
          { "id": "n14", "type": "slider", "props": { "label": "Schriftgröße", "min": 10, "max": 24, "value": 14.5, "step": 0.5, "show_value": true, "width": "fill" } },
          { "id": "n15", "type": "segmented", "props": { "items": "Kompakt\nNormal", "full_width": true } }
        ] },
        { "id": "n16", "type": "card", "props": { "pad": 16, "gap": 10, "muted": true }, "children": [
          { "id": "n17", "type": "select", "props": { "label": "Sprache", "items": "Deutsch\nEnglish\nFrançais", "value": 0, "width": "fill" } },
          { "id": "n18", "type": "radio_group", "props": { "items": "Täglich\nWöchentlich\nNie", "value": 1, "bind": "frequency" } },
          { "id": "n19", "type": "checkbox", "props": { "label": "Newsletter", "disabled": true } }
        ] }
      ] },
      { "id": "n20", "type": "card", "props": { "dir": "row", "pad": 16, "gap": 12, "width": "fill", "align": "center" }, "children": [
        { "id": "n21", "type": "input", "props": { "label": "Name", "value": "Ada \"Lovelace\"", "clearable": true, "width": "50%" } },
        { "id": "n22", "type": "textarea", "props": { "label": "Über mich", "value": "Zeile 1\nZeile 2", "height": 64, "width": "fill", "hint": "Max. 200 Zeichen" } }
      ] },
      { "id": "n23", "type": "progress", "props": { "value": 0.35, "label": "Speicher", "show_value": true, "tone": "warning", "width": "fill" } },
      { "id": "n24", "type": "separator", "props": {} },
      { "id": "n25", "type": "row", "props": { "gap": 8, "justify": "end", "width": "fill" }, "children": [
        { "id": "n26", "type": "text", "props": { "text": "v1.5 · 100% C", "style": "muted" } },
        { "id": "n27", "type": "button", "props": { "label": "Abbrechen", "variant": "ghost", "width": "120" } },
        { "id": "n28", "type": "button", "props": { "label": "Löschen", "variant": "danger", "disabled": true } }
      ] },
      { "id": "n29", "type": "column", "props": { "gap": 4 }, "children": [] }
    ]
  }
}
